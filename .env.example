# Copia este archivo como .env y cambia los valores

# Puerto del servidor en tu computador (en el hosting no importa: el hosting da su puerto en PORT)
PUERTO=3000

# Clave que comparte la ESP32-CAM con el servidor (solo letras y números)
TOKEN_DISPOSITIVO=cambia-este-token

# PIN para tomar el control del monitor (solo una persona maneja la caneca a la vez)
PIN_CONTROL=1234

# Clave de Gemini (Google AI Studio). Va SOLO aquí o en las variables del hosting, nunca en GitHub.
GEMINI_API_KEY=

# Opcional: otro modelo de Gemini (vacío = gemini-3.1-flash-lite)
MODELO_IA=

# Gemini: baja = más rápido y barato (recomendado); normal = más detalle
RESOLUCION_IA=baja
# Si la IA tarda más de esto (ms), se corta y se pregunta otra vez
TIEMPO_MAX_IA_MS=5000

# A qué caneca inclina la bandeja cada tipo: aprovechables (lado del 180, 150°),
# no_aprovechables (lado del 0, 30°, el mismo de vaciar) o nivel (no se mueve).
LADO_BLANCA=aprovechables
LADO_VERDE=no_aprovechables
LADO_NEGRA=no_aprovechables
LADO_ESPECIAL=no_aprovechables
# Las clases (qué reconoce y a qué caneca va cada una) se editan en clases.json

# 1 = clasifica al azar, sin gastar la API (para probar)
MODO_PRUEBA=0

# Opcional: dónde guardar historial, estadísticas y fotos. Vacío = en el hosting (Linux) ~/caneca-datos,
# fuera de la carpeta del programa, para que no se borren al volver a desplegar; en el Mac, servidor/datos.
DIR_DATOS=
